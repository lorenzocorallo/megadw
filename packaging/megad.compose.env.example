# Copy this file to an operator-managed .env file and replace every path.
# Do not use the state host path for transfer storage.
MEGAD_IMAGE=ghcr.io/lorenzocorallo/megadw@sha256:replace-with-release-digest
MEGAD_PORT=8080
# Exact browser-visible Host value. Include the published port when nonstandard.
MEGAD_ALLOWED_HOSTS=127.0.0.1:8080
MEGAD_STATE_HOST_PATH=/absolute/path/chosen-by-operator/state
MEGAD_TRANSFER_HOST_PATH=/absolute/path/chosen-by-operator/transfer
MEGAD_TRANSFER_CONTAINER_ROOT=/absolute/container/path/chosen-by-operator
