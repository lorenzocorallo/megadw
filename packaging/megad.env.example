# Optional overrides for /usr/local/bin/megad. The default listener is
# loopback-only; expose it through a reverse proxy or set an explicit LAN
# address only after the administrator account has been bootstrapped.
# MEGAD_LISTEN=127.0.0.1:8080
# MEGAD_STATE_DIR=/var/lib/megad
# MEGAD_DATABASE=/var/lib/megad/megad.sqlite3
# MEGAD_SECRET_KEY=/var/lib/megad/secret.key
# Set this when an HTTPS reverse proxy is the only browser entry point.
# MEGAD_SECURE_COOKIES=true
# Comma-separated browser Host values when using a reverse-proxy DNS name.
# MEGAD_ALLOWED_HOSTS=downloads.example.test
# Transfer roots are not environment defaults. Configure both absolute roots
# in the authenticated Settings page/API after installation; existing jobs
# retain the roots persisted with them.
