[Unit]
Description=MEGA Downloader
Documentation=https://github.com/lorenzocorallo/megadw
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=megad
Group=media
ExecStart=/usr/local/bin/megad
EnvironmentFile=-/etc/megad/megad.env
StateDirectory=megad
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictNamespaces=true
PrivateDevices=true
# Transfer roots are deliberately not baked into the unit. Add the two
# explicitly configured roots in a megad.service drop-in after setup; keeping
# this allow-list narrow preserves ProtectSystem=strict for the native install.
ReadWritePaths=/var/lib/megad

[Install]
WantedBy=multi-user.target
