# Copy this file to an operator-managed .env file and replace every path.
# Do not use the state host path for transfer storage.
MEGADW_IMAGE=ghcr.io/lorenzocorallo/megadw@sha256:replace-with-release-digest
MEGADW_PORT=8080
# Exact browser-visible Host value. Include the published port when nonstandard.
MEGADW_ALLOWED_HOSTS=127.0.0.1:8080
# Set true when TLS terminates at a reverse proxy in front of the container.
MEGADW_SECURE_COOKIES=false
MEGADW_STATE_HOST_PATH=/absolute/path/chosen-by-operator/state
MEGADW_TRANSFER_HOST_PATH=/absolute/path/chosen-by-operator/transfer
MEGADW_TRANSFER_CONTAINER_ROOT=/absolute/container/path/chosen-by-operator
